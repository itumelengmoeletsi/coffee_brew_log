# Backend Environment Template
# Copy this file to .env for local development

# Application Settings
APP_NAME="Coffee Brew Log API"
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Local PostgreSQL: postgresql://postgres:password@localhost:5432/brew_db
# Render PostgreSQL: postgresql://<user>:<password>@<host>/<dbname>
DATABASE_URL=postgresql://user:password@localhost:5432/coffee_brew_db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000